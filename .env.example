# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=dev
DATABASE_URL=sqlite:///./booking.db
SECRET_KEY=dev-only-change-me
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# Calendar.  fake | relay | google
#   dev/local -> fake
#   prod      -> relay   (booking app on Tencent Cloud, relay on Railway)
# ---------------------------------------------------------------------------
CALENDAR_GATEWAY=fake
CALENDAR_RELAY_URL=https://your-relay.up.railway.app
CALENDAR_RELAY_SECRET=

# Only needed for CALENDAR_GATEWAY=google (local dev, or the relay itself).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Payments.  fake | wechat
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=fake
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=./secrets/apiclient_key.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=./secrets/pub_key.pem

# ---------------------------------------------------------------------------
# Booking policy
# ---------------------------------------------------------------------------
HOLD_MINUTES=10
SLOT_STEP_MINUTES=15
SWEEPER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Email.  console | smtp
# ---------------------------------------------------------------------------
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Prod only: Celery broker / result backend (Railway Redis plugin)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
